# PostgreSQL Database URL (Exemple: Supabase / Neon / Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storelect_db?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="storelect_super_secret_jwt_key_at_least_32_characters_long_for_security"

# Stripe Payments Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
